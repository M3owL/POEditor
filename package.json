{
  "name": "poeditor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "M3owL — translation editor for PO, XLIFF, XLSX, JSON and more",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/publish.mjs",
    "preview": "vite preview --port 4173",
    "test": "node app/scripts/format-test.mjs && node app/scripts/spreadsheet-test.mjs && node app/scripts/conversion-test.mjs",
    "test:formats": "node app/scripts/format-test.mjs",
    "test:spreadsheet": "node app/scripts/spreadsheet-test.mjs",
    "test:conversion": "node app/scripts/conversion-test.mjs",
    "test:render": "vite build --ssr scripts/render-test.jsx --outDir ../.ssr-test --logLevel warn && node .ssr-test/render-test.js",
    "verify": "npm run test && npm run test:render"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
